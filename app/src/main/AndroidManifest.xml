<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Exact alarms start monitoring at each period start; granted at install, no prompt. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Configuration import (DESIGN.md §8): the official app shares its setup only with apps
         signed with the same key. Every build declares and holds the permission; the name is
         fixed, so the official app and the test builds share it. -->
    <permission
        android:name="io.github.anderewrey.bustracker.permission.EXPORT_CONFIG"
        android:label="Read Bus Tracker's configuration"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.anderewrey.bustracker.permission.EXPORT_CONFIG" />

    <!-- A test build asks the official app for its configuration. -->
    <queries>
        <package android:name="io.github.anderewrey.bustracker" />
    </queries>

    <application
        android:name=".BusTrackerApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="${appLabel}"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".monitor.MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".monitor.StartAlarmReceiver"
            android:exported="false" />

        <provider
            android:name=".ConfigExport"
            android:authorities="${applicationId}.export"
            android:exported="true"
            android:permission="io.github.anderewrey.bustracker.permission.EXPORT_CONFIG" />

        <receiver
            android:name=".monitor.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
